Package: tbepreport
Title: Compile and Visualize Ecosystem Report Card Indicators for Tampa Bay
Version: 0.0.0.9000
Authors@R:
    person(given = "Marcus",
      family = "Beck",
      role = c("aut", "cre"),
      email = "mbeck@tbep.org",
      comment = c(ORCID = "0000-0002-4996-0059")
